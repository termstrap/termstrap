{
    "name": "codes-sh/termstrap",
    "description": "Native PHP port of Termstrap terminal rendering engine",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.1",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "league/commonmark": "^2.5 || ^2.6",
        "sabberworm/php-css-parser": "^8.7 || ^9.0",
        "symfony/console": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/tui": "^8.1",
        "tempest/highlight": "^2.16 || ^2.30"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Termstrap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Termstrap\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/termstrap"
    ]
}
